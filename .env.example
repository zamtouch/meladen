# Copy to .env.local. Do not commit .env.local.

PAYLOAD_SECRET=replace-with-a-long-random-string
DATABASE_URL=file:./meladen.db
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Optional. Created on first boot only when both values are set and no staff user exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Google Analytics 4. Leave blank until a property exists.
# Events: bulk_quote_started, bulk_quote_submitted, contact_submitted,
# station_selected, directions_clicked, phone_clicked, company_profile_downloaded.
# Message text is not sent to analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Staff notification email via Resend. If any value is missing, enquiries are still saved
# and marked not_configured in the admin. A failed send does not reject the enquiry.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_NOTIFY_EMAIL=
